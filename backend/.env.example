DATABASE_URL=sqlite:///./oncoai.db
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required for the AI Clinical Assistant (Patient Profile > AI Analysis tab).
# Without this set, AI endpoints respond with a clear "not configured" message
# instead of an error — the rest of the app works fine without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
